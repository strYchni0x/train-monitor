msgstr "Für dieses Diagramm liegen noch nicht genug Daten vor."

msgid "%1$s: average %2$s min delay, %3$s %% delayed, %4$d trips, %5$d cancelled"
msgstr "%1$s: durchschnittlich %2$s Min Verspätung, %3$s %% verspätet, %4$d Fahrten, %5$d Ausfälle"

msgid "Bar height: average delay in minutes (cancellations excluded). Faded bars are based on fewer than %d trips."
msgstr "Balkenhöhe: durchschnittliche Verspätung in Minuten (ohne Ausfälle). Blasse Balken beruhen auf weniger als %d Fahrten."

